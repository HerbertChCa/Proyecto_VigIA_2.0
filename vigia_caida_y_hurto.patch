+        def poses(t):
+            if t < 4:
+                return de_pie
+            a = min(1.0, (t - 4) / 0.8)              # cae en 0.8 s y se queda en el suelo
+            return _comprimir(de_pie, 480, 1 - 0.8 * a, 400)
+        tipos = self.correr(poses)
+        self.assertIn("caida", tipos)
